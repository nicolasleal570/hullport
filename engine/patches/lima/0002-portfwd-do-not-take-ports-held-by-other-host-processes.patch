+// errPortInUse reports a host port that another process already listens on.
+var errPortInUse = errors.New("already in use on the host by another process")
+
+// checkWildcardFree refuses a specific address such as 127.0.0.1:P while another process
+// listens on *:P. macOS lets the more specific bind succeed, which would silently take
+// localhost traffic away from that process.
+func checkWildcardFree(ctx context.Context, ip net.IP, port string) error {
+	if ip.IsUnspecified() {
+		// Binding the wildcard itself already fails when it is taken.
+		return nil
+	}
+	// SO_REUSEADDR (via Control) keeps sockets in TIME_WAIT from counting as in use.
+	lc := net.ListenConfig{Control: Control}
+	probe, err := lc.Listen(ctx, "tcp4", net.JoinHostPort("0.0.0.0", port))
+	if errors.Is(err, syscall.EADDRINUSE) {
+		return fmt.Errorf("port %s is %w", port, errPortInUse)
+	}
+	if err != nil {
+		return nil
+	}
+	return probe.Close()
+}
