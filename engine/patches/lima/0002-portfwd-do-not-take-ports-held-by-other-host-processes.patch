@@ -0,0 +1,35 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package portfwd
+
+import (
+	"net"
+	"strconv"
+	"testing"
+
+	"gotest.tools/v3/assert"
+
+	"github.com/lima-vm/lima/v2/pkg/freeport"
+)
+
+// Another app (e.g. another Docker engine) publishing *:P must keep localhost:P.
+func TestListenRefusesPortTakenByWildcardListener(t *testing.T) {
+	lc := net.ListenConfig{Control: Control}
+	holder, err := lc.Listen(t.Context(), "tcp4", "0.0.0.0:0")
+	assert.NilError(t, err)
+	defer holder.Close()
+	port := strconv.Itoa(holder.Addr().(*net.TCPAddr).Port)
+
+	_, err = Listen(t.Context(), lc, net.JoinHostPort("127.0.0.1", port))
+	assert.ErrorIs(t, err, errPortInUse)
+}
+
+func TestListenAcceptsFreePort(t *testing.T) {
+	port, err := freeport.TCP()
+	assert.NilError(t, err)
+
+	l, err := Listen(t.Context(), net.ListenConfig{Control: Control}, net.JoinHostPort("127.0.0.1", strconv.Itoa(port)))
+	assert.NilError(t, err)
+	assert.NilError(t, l.Close())
+}
