diff --git a/pkg/services/dns/dns.go b/pkg/services/dns/dns.go
index aeeb976..63fa9d3 100644
--- a/pkg/services/dns/dns.go
+++ b/pkg/services/dns/dns.go
@@ -36,8 +36,13 @@ type dnsHandler struct {
 	// look up directly (SOA, PTR, AAAA, CAA, ...).
 	nameservers []string
 	client      *dns.Client
+	tcpClient   *dns.Client
 }
 
+// upstreamUDPSize is the EDNS0 buffer advertised to upstream nameservers, so
+// answers larger than 512 bytes (e.g. a dozen AAAA records) fit in one UDP reply.
+const upstreamUDPSize = 4096
+
 func (h *dnsHandler) handle(w dns.ResponseWriter, r *dns.Msg, responseMessageSize int) {
 	m := new(dns.Msg)
 	m.SetReply(r)
@@ -267,9 +272,14 @@ func (h *dnsHandler) addAnswersFromNameservers(m *dns.Msg, q dns.Question) {
 	req := new(dns.Msg)
 	req.SetQuestion(q.Name, q.Qtype)
 	req.RecursionDesired = true
+	req.SetEdns0(upstreamUDPSize, false)
 
 	for _, ns := range h.nameservers {
 		resp, _, err := h.client.Exchange(req, ns)
+		if err != nil || resp == nil || resp.Truncated {
+			// The answer didn't fit in a UDP reply: ask the same server over TCP.
+			resp, _, err = h.tcpClient.Exchange(req, ns)
+		}
 		if err != nil || resp == nil {
 			continue
 		}
@@ -321,7 +331,8 @@ func NewWithUpstreamResolver(udpConn net.PacketConn, tcpLn net.Listener, zones [
 		zones:       zones,
 		upstream:    upstream,
 		nameservers: hostNameservers(),
-		client:      &dns.Client{},
+		client:      &dns.Client{UDPSize: upstreamUDPSize},
+		tcpClient:   &dns.Client{Net: "tcp"},
 	}
 	return &Server{udpConn: udpConn, tcpLn: tcpLn, handler: handler}, nil
 }
